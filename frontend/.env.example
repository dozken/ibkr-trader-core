# IBKR Shariah Trader — Frontend Environment Variables
# Copy to .env for local development or set at build time.

# The base URL of the backend API
# VITE_API_BASE=http://localhost:8000

# The API key required for sensitive actions (e.g. /approve).
# This MUST match the IBKR_API_KEY set in the backend's .env.
#
# DEV SERVER ONLY (`bun dev`). The container does NOT build this in — Vite would
# inline it into the hashed bundle and ship a credential inside the published
# image. In Docker the entrypoint writes it to /config.js at start, from the
# IBKR_API_KEY env var, so rotating the key is a restart rather than a rebuild.
VITE_IBKR_API_KEY=
