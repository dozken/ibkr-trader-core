{
  "name": "ibkr-shariah-trader-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "generate-types": "bunx openapi-typescript http://localhost:8000/openapi.json -o src/shared/types/api.gen.ts",
    "typecheck": "tsgo --noEmit",
    "lint:features": "node scripts/check-feature-classnames.mjs",
    "check": "bunx biome check --write . && bun run lint:features",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "knip": "knip"
  },
  "dependencies": {
    "@aegov/design-system": "^3.0.7",
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-router": "^1.168.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.284.0",
    "react": "^19.2.7",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^2.9.0",
    "shadcn": "^4.5.0",
    "tailwind-merge": "^1.14.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^18.2.7",
    "@typescript/native-preview": "^7.0.0-dev.20260426.1",
    "@vitejs/plugin-react-swc": "^3.3.2",
    "jsdom": "^29.0.2",
    "knip": "^6.14.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.28",
    "tailwindcss": "^4",
    "typescript": "latest",
    "vite": "^4.4.5",
    "vitest": "^4.1.5"
  }
}
