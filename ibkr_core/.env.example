# IBKR connection
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=

# Strategy plugin — defaults to bundled SMA crossover.
# Format: module.path:ClassName
# Examples:
#   backend.strategies.sma_crossover:SMACrossover
#   backend.strategies.buy_and_hold:BuyAndHold
#   my_alpha.strategy:MyAlpha
STRATEGY_CLASS=backend.strategies.sma_crossover:SMACrossover

# Compliance (AAOIFI defaults — adjust to your tolerance / madhhab)
COMPLIANCE_DEBT_TO_ASSET_MAX=0.33
COMPLIANCE_CASH_TO_ASSET_MAX=0.33
COMPLIANCE_NON_COMPLIANT_REV_MAX=0.05
COMPLIANCE_STALENESS_DAYS=90

# Scanner thresholds
SCAN_RSI_OVERSOLD=30
SCAN_RSI_OVERBOUGHT=70

# Database
DATABASE_URL=sqlite:///./trading.db

# Dev mode (bypass API key auth for local development)
DEV_MODE=true
API_KEY=

# ── Alerts ────────────────────────────────────────────────────────────────────
# Telegram (enable via Settings → Alert Channels → Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Slack
SLACK_WEBHOOK_URL=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Grafana admin password (defaults to "admin" if unset — set this for any
# non-local deployment).
GRAFANA_PASSWORD=

# ── External data (optional) ──────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=demo
FMP_API_KEY=
